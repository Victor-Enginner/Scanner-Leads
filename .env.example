# Copie para .env.local e preencha. Nunca commite o .env.local.

# Banco Postgres (local ou Supabase/Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_scan

# NextAuth — gere o segredo com: npx auth secret  (ou openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Login com Google (console.cloud.google.com → Credenciais → OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login por e-mail (SMTP; com Resend: host smtp.resend.com, usuário "resend", senha = chave da API)
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=resend
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# Busca de empresas (Google Places API) e análise com IA
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=

# Pagamentos (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_CHECKOUT_URL=

# Armazenamento de arquivos compatível com S3 (AWS S3, Cloudflare R2, MinIO)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
